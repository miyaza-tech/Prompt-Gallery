rules_version = '2';

// Prompt Gallery - Cloud Storage rules
// Paste into Firebase Console > Storage > Rules.
//
// Images are world-readable so <img> tags work for logged-out visitors and so
// download URLs keep working once issued. Only signed-in users can upload or
// delete, and uploads are capped at 10MB of image data to match the client-side
// validation in js/app.js.
service firebase.storage {
  match /b/{bucket}/o {
    match /prompt-images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
